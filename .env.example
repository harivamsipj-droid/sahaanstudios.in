GOOGLE_PLACES_API_KEY=

# Keep both launch switches off until legal review, persistent storage,
# Razorpay test/live keys, and approved Meta WhatsApp templates are ready.
SAHAAN_PAYMENTS_ENABLED=0
SAHAAN_POLICY_APPROVED=0
# Absolute path to a persistent, private, backed-up file outside the deploy directory.
SAHAAN_DATA_FILE=
# Optional SQLite file for local development; not used on Hostinger production.
SAHAAN_INQUIRY_DATA_FILE=
# Preferred for Hostinger production: a backed-up MySQL database.
SAHAAN_MYSQL_HOST=
SAHAAN_MYSQL_USER=
SAHAAN_MYSQL_PASSWORD=
SAHAAN_MYSQL_DATABASE=
# Keep this off until Meta sender, approved utility template, delivery test,
# and Sahaan's WhatsApp opt-out handling have been verified.
SAHAAN_WHATSAPP_REQUESTS_ENABLED=0
# Customer request form stays in WhatsApp-only fallback mode until a database
# and the admin token are configured.
# Generate a unique random value of at least 32 characters. Never commit it.
SAHAAN_ADMIN_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_VERSION=
META_TEMPLATE_LANGUAGE=en_US
META_TEMPLATE_PAYMENT=
META_TEMPLATE_CUSTOMER_ASSIGNED=
META_TEMPLATE_ARTIST_ASSIGNED=
# Approved utility template with five body variables:
# customer name, request reference, service, preferred date, preferred time.
META_TEMPLATE_REQUEST_RECEIVED=
