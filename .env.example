GOOGLE_PLACES_API_KEY=

# Keep both launch switches off until legal review, persistent storage,
# Razorpay live keys/webhook, manual-staff readiness or approved Meta templates,
# and end-to-end payment/refund tests are complete.
SAHAAN_PAYMENTS_ENABLED=0
SAHAAN_POLICY_APPROVED=0
# Test mode accepts fictional customer/artist details only and sends no WhatsApp.
# Never pair this with a live Razorpay key. Leave at 0 for real bookings.
SAHAAN_PAYMENT_TEST_MODE=0
# For the first three-month staffed pilot, use manual WhatsApp Business app
# messages instead of the Meta API. Keep this unset in test mode.
# Set the pilot end to three calendar months after the actual live start date.
# After that date new payment orders and quotes stop; existing bookings remain manageable.
SAHAAN_NOTIFICATION_MODE=manual
SAHAAN_MANUAL_PILOT_END=
# Synthetic test bookings only. Never use this temporary SQLite file for real payments.
SAHAAN_DATA_FILE=
# Optional SQLite file for local development; not used on Hostinger production.
SAHAAN_INQUIRY_DATA_FILE=
# Required for real managed payments and customer requests on Hostinger.
# Back up and restore-test the database before collecting a real payment.
SAHAAN_MYSQL_HOST=
SAHAAN_MYSQL_USER=
SAHAAN_MYSQL_PASSWORD=
SAHAAN_MYSQL_DATABASE=
# Keep this off until Meta sender, approved utility template, delivery test,
# and Sahaan's WhatsApp opt-out handling have been verified.
SAHAAN_WHATSAPP_REQUESTS_ENABLED=0
# Customer request form stays in WhatsApp-only fallback mode until a database
# and the admin token are configured.
# Generate a unique random value of at least 32 characters. Never commit it.
SAHAAN_ADMIN_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Test-mode webhook signing secret. Do not reuse it for live events.
RAZORPAY_WEBHOOK_SECRET=
# Separate 32+ character live webhook signing secret. It may be installed
# before live checkout; verified live events are acknowledged but not booked
# while the website remains in test mode.
RAZORPAY_LIVE_WEBHOOK_SECRET=
# The following are required only if SAHAAN_NOTIFICATION_MODE is not manual.
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_VERSION=
META_TEMPLATE_LANGUAGE=en_US
META_TEMPLATE_PAYMENT=
META_TEMPLATE_CUSTOMER_ASSIGNED=
META_TEMPLATE_ARTIST_ASSIGNED=
# Approved utility template with five body variables:
# customer name, request reference, service, preferred date, preferred time.
META_TEMPLATE_REQUEST_RECEIVED=
